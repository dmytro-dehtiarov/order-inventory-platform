# For Docker (docker compose up): DB_HOST=localhost, DB_SERVICE=FREEPDB1
# For a remote/VM instance: use that instance's IP and service name
DB_HOST=
DB_PORT=1521
DB_SERVICE=
DB_USER=
DB_PASSWORD=

# Integration tests (AbstractIntegrationTest) connect to a separate,
# isolated schema/user (oip_test) on the same Oracle instance, so Flyway's
# "clean" command never touches the main application schema above.
TEST_DB_USER=oip_test
TEST_DB_PASSWORD=
